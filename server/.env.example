# Copy to server/.env for local development.
# All values are optional; the defaults below match the server config.

NODE_ENV=development
PORT=3001

# Serve the built React app from client/dist.
# Defaults to true in production, or whenever client/dist/index.html exists.
SERVE_CLIENT=false

# Comma-separated browser origins allowed to call the API and Socket.IO.
# Leave empty when the web app and API share an origin.
# CLIENT_ORIGINS=https://app.example.com

# Reverse proxy hops to trust (1 behind Render/Cloudflare; default 1 in production).
# TRUST_PROXY=1

# Where temporary uploads live. Relative paths resolve inside server/.
STORAGE_DIR=storage

# How long an idle drop stays open (minutes, 1-1440).
SESSION_TTL_MINUTES=30
# How long each delivered file stays downloadable (minutes, 1-10080).
FILE_RETENTION_MINUTES=60
# Incomplete uploads are discarded after this long (minutes).
UPLOAD_TTL_MINUTES=60

# Upload limits.
MAX_FILE_SIZE_MB=2048
MAX_SESSION_SIZE_MB=5120
MAX_FILES_PER_SESSION=100
MAX_MESSAGES_PER_SESSION=200
MAX_TEXT_LENGTH=10000
CHUNK_SIZE_MB=4

# Rate limits.
RATE_LIMIT_SESSION_PER_HOUR=30
RATE_LIMIT_UPLOAD_PER_MINUTE=1200
# RATE_LIMIT_DISABLED=true
