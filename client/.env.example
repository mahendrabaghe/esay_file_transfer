# Vite reads these at build time; rebuild after changing them.
# Leave both values empty when the API and web app share an origin
# (the default Render one-service deployment and local Vite proxy).
#
# For a separately hosted frontend:
# VITE_API_URL=https://quickdrop-api.onrender.com
# VITE_PUBLIC_APP_URL=https://quickdrop.example.com

# When the app is opened at localhost, QuickDrop automatically uses a private
# LAN address for the QR so phones on the same network can connect. Set this
# only to override the detected address or when the frontend and API are on
# different origins.
# VITE_PUBLIC_APP_URL=http://192.168.1.20:5173
